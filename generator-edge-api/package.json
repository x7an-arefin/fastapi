{
  "name": "generator-edge-api",
  "version": "1.0.0",
  "description": "Yeoman generator for full-feature, event-driven, lifecycle-aware CRUD APIs on Cloudflare Workers",
  "keywords": [
    "yeoman-generator",
    "cloudflare-workers",
    "hono",
    "drizzle",
    "cockroachdb",
    "event-driven",
    "crud"
  ],
  "homepage": "https://github.com/your-org/generator-edge-api",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "edge-api": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "schemas"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "yeoman-generator": "8.2.2",
    "yo": "7.0.1",
    "zod": "4.4.3",
    "ejs": "6.0.1",
    "chalk": "6.0.0",
    "mem-fs-editor": "12.0.6",
    "ajv": "8.20.0",
    "glob": "13.0.6",
    "prettier": "3.9.6"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.0.0",
    "@types/ejs": "3.1.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "yo": "^7.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
