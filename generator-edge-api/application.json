{
  "$schema": "./schemas/application.schema.json",
  "specVersion": "1.0",
  "application": {
    "name": "commerce-api",
    "domain": "commerce",
    "apiPrefix": "/api/v1",
    "runtime": "cloudflare-workers",
    "framework": "hono",
    "language": "typescript"
  },
  "database": {
    "provider": "cockroachdb",
    "connection": "hyperdrive",
    "orm": "drizzle",
    "binding": "HYPERDRIVE",
    "migrations": true
  },
  "authentication": {
    "provider": "better-auth",
    "session": {
      "primaryStore": "cockroachdb",
      "cache": "workers-kv",
      "kvBinding": "AUTH_SESSION_KV",
      "writePolicy": "auth-events-only"
    }
  },
  "events": {
    "version": 1,
    "defaultPostMode": "queue",
    "queueBinding": "DOMAIN_EVENTS",
    "deadLetterQueueBinding": "DOMAIN_EVENTS_DLQ",
    "includeCorrelationId": true,
    "includeActor": true
  },
  "entities": {
    "product": {
      "table": "products",
      "fields": {
        "id": {
          "type": "uuid",
          "primary": true,
          "generated": true
        },
        "name": {
          "type": "string",
          "required": true,
          "minLength": 2,
          "maxLength": 150
        },
        "slug": {
          "type": "string",
          "required": true,
          "unique": true,
          "maxLength": 200
        },
        "description": {
          "type": "text",
          "required": false
        },
        "price": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "required": true
        },
        "status": {
          "type": "enum",
          "values": ["draft", "active", "archived"],
          "default": "draft"
        },
        "ownerId": {
          "type": "uuid",
          "required": true
        },
        "createdAt": {
          "type": "timestamp",
          "generated": "createdAt"
        },
        "updatedAt": {
          "type": "timestamp",
          "generated": "updatedAt"
        }
      },
      "indexes": [
        {
          "name": "products_owner_status_idx",
          "fields": ["ownerId", "status"]
        },
        {
          "name": "products_slug_unique_idx",
          "fields": ["slug"],
          "unique": true
        }
      ],
      "crud": {
        "create": {
          "enabled": true,
          "method": "POST",
          "path": "/products",
          "auth": true,
          "permissions": ["product:create"],
          "idempotency": true,
          "select": ["id", "name", "slug", "price", "status", "createdAt"],
          "lifecycle": {
            "pre": ["authenticate", "authorize", "ensureUniqueSlug"],
            "process": ["createProduct"],
            "post": ["publishProductCreated", "queueAuditEvent"]
          }
        },
        "get": {
          "enabled": true,
          "method": "GET",
          "path": "/products/:id",
          "auth": false,
          "cache": {
            "mode": "http",
            "maxAge": 60
          },
          "select": ["id", "name", "slug", "description", "price", "status", "createdAt"]
        },
        "list": {
          "enabled": true,
          "method": "GET",
          "path": "/products",
          "auth": false,
          "pagination": {
            "type": "cursor",
            "defaultLimit": 20,
            "maximumLimit": 100
          },
          "filter": ["status", "ownerId"],
          "sort": ["createdAt", "price"],
          "select": ["id", "name", "slug", "price", "status", "createdAt"]
        },
        "update": {
          "enabled": true,
          "method": "PATCH",
          "path": "/products/:id",
          "auth": true,
          "permissions": ["product:update"],
          "concurrency": {
            "mode": "updatedAt"
          },
          "select": ["id", "name", "slug", "price", "status", "updatedAt"]
        },
        "delete": {
          "enabled": true,
          "method": "DELETE",
          "path": "/products/:id",
          "auth": true,
          "permissions": ["product:delete"],
          "mode": "soft"
        }
      }
    }
  },
  "storage": {
    "provider": "backblaze-b2",
    "uploadMode": "presigned-url",
    "publicBaseUrl": "https://media.example.com",
    "maximumUploadBytes": 10485760,
    "allowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ]
  },
  "email": {
    "provider": "resend",
    "execution": "queue-only"
  },
  "webhooks": {
    "stripe": {
      "path": "/webhooks/stripe",
      "signature": {
        "type": "stripe",
        "secretBinding": "STRIPE_WEBHOOK_SECRET"
      },
      "queue": "DOMAIN_EVENTS",
      "responseStatus": 202
    }
  },
  "scheduled": {
    "cleanupStaleSessions": {
      "cron": "0 2 * * *",
      "description": "Delete expired session records from CockroachDB"
    }
  },
  "observability": {
    "correlationHeader": "x-correlation-id",
    "structuredLogs": true,
    "provider": "new-relic",
    "transport": "cloudflare-logpush",
    "profile": "free"
  },
  "budgets": {
    "request": {
      "maximumDatabaseQueries": 3,
      "maximumKvReads": 2,
      "maximumKvWrites": 0,
      "maximumQueueWrites": 2,
      "maximumB2Operations": 1
    }
  }
}
