import { Hono } from 'hono';
import type { Env } from '../generated/bindings.js';
<%ir.entities.forEach(function(entity) {%><%entity.operations.forEach(function(op) {%>
import { <%= naming.toCamelCase(op.operation) %><%= entity.namePascal %>Route } from '../modules/<%= entity.nameKebab %>/<%= op.operation %>/<%= op.operation %>-<%= entity.nameKebab %>.route.js';<%});%><%});%>
<%if (ir.storage) {%>
import { uploadUrlRoute, completeUploadRoute } from '../modules/media/media.routes.js';<%}%>
<%ir.webhooks.forEach(function(wh) {%>
import { <%= wh.name %>WebhookHandler } from '../webhooks/<%= wh.name %>/handler.js';<%});%>

/**
 * @author arefin
 * @description Register all CRUD route handlers, media routes, and webhook routes on the Hono application instance
 */
export function registerRoutes(app: Hono<{ Bindings: Env }>): void {
<%ir.entities.forEach(function(entity) {%>
<%entity.operations.forEach(function(op) {%>  app.<%= op.method.toLowerCase() %>('<%= op.fullPath %>', <%= naming.toCamelCase(op.operation) %><%= entity.namePascal %>Route);
<%});%>
<%});%><%if (ir.storage) {%>
  app.post('<%= app.apiPrefix %>/media/upload-url', uploadUrlRoute);
  app.post('<%= app.apiPrefix %>/media/complete', completeUploadRoute);
<%}%><%if (ir.webhooks.length > 0) {%>
<%ir.webhooks.forEach(function(wh) {%>  app.post('<%= wh.path %>', <%= wh.name %>WebhookHandler);
<%});%><%}%>
}
