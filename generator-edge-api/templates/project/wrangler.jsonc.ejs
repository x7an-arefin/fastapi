{
  "name": "<%= app.nameKebab %>",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "hyperdrive": [
    {
      "binding": "<%= db.binding %>",
      "id": "YOUR_HYPERDRIVE_ID_HERE"
    }
  ]<%
  const kvs = [];
  if (auth && auth.session.cache === 'workers-kv') {
    kvs.push({ binding: auth.session.kvBinding, id: 'YOUR_KV_NAMESPACE_ID_HERE' });
  }
  if (security && security.rateLimit.enabled && security.rateLimit.store === 'kv') {
    kvs.push({ binding: security.rateLimit.kvBinding, id: 'YOUR_RATE_LIMIT_KV_ID_HERE' });
  }
  if (kvs.length > 0) {
%>,

  "kv_namespaces": [<%kvs.forEach(function(kv, i) {%>
    {
      "binding": "<%= kv.binding %>",
      "id": "<%= kv.id %>"
    }<%if (i < kvs.length - 1) {%>,<%}%><%});%>
  ]<%}%><%if (events.queueBinding) {%>,

  "queues": {
    "producers": [
      {
        "binding": "<%= events.queueBinding %>",
        "queue": "<%= app.nameKebab %>-domain-events"
      }<%if (events.deadLetterQueueBinding) {%>,
      {
        "binding": "<%= events.deadLetterQueueBinding %>",
        "queue": "<%= app.nameKebab %>-domain-events-dlq"
      }<%}%>
    ],
    "consumers": [
      {
        "queue": "<%= app.nameKebab %>-domain-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "<%= app.nameKebab %>-domain-events-dlq"
      }
    ]
  }<%}%><%if (ir.scheduled.length > 0) {%>,

  "triggers": {
    "crons": [<%ir.scheduled.forEach(function(job, i) {%>
      "<%= job.cron %>"<%if (i < ir.scheduled.length - 1) {%>,<%}%><%});%>
    ]
  }<%}%>,

  "vars": {
    "ENVIRONMENT": "development"
  },

  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
