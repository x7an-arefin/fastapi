import { Service } from 'honestjs';
import { drizzle } from 'drizzle-orm/postgres-js';
import { eq, and, lt, desc, isNull<% if (!entity.hasSoftDelete) { %>, isNotNull<% } %> } from 'drizzle-orm';
import type { <%= entity.namePascal %>Entity, New<%= entity.namePascal %>, Update<%= entity.namePascal %>, I<%= entity.namePascal %>Repository, List<%= entity.namePascal %>Params, List<%= entity.namePascal %>Result } from './<%= entity.nameKebab %>.types.js';
import { <%= entity.nameKebab %>Table } from './<%= entity.nameKebab %>.schema.js';
import { AppError } from '@core/errors/application-error.js';

@Service()
export class <%= entity.namePascal %>Repository implements I<%= entity.namePascal %>Repository {

  /**
   * @author arefin
   * @description Get a Drizzle database client from the Cloudflare Hyperdrive connection
   */
  private getDb(hyperdrive?: Hyperdrive): ReturnType<typeof drizzle> {
    if (!hyperdrive?.connectionString) {
      throw new AppError('MISSING_BINDING', 'Hyperdrive binding is required. Ensure HYPERDRIVE is configured in wrangler.jsonc.', 500);
    }
    return drizzle(hyperdrive.connectionString, { logger: false });
  }

  /**
   * @author arefin
   * @description Find a single <%= entity.namePascal %> entity by its unique identifier
   */
  async findById(id: string, hyperdrive?: Hyperdrive): Promise<<%= entity.namePascal %>Entity | null> {
    const rows = await this.getDb(hyperdrive)
      .select()
      .from(<%= entity.nameKebab %>Table)
      .where(
        and(
          eq(<%= entity.nameKebab %>Table.id, id)<% if (entity.hasSoftDelete) { %>,
          isNull(<%= entity.nameKebab %>Table.deletedAt)<% } %>
        )
      )
      .limit(1);
    return rows[0] ?? null;
  }

  /**
   * @author arefin
   * @description Retrieve a paginated list of <%= entity.namePascal %> entities with cursor-based pagination on createdAt
   */
  async findAll(params: List<%= entity.namePascal %>Params, hyperdrive?: Hyperdrive): Promise<List<%= entity.namePascal %>Result> {
    const limit = Math.min(params.limit ?? 20, 100);
    const conditions = [];

<% if (entity.hasSoftDelete) { %>
    conditions.push(isNull(<%= entity.nameKebab %>Table.deletedAt));
<% } %>
    if (params.cursor) {
      conditions.push(lt(<%= entity.nameKebab %>Table.createdAt, new Date(params.cursor)));
    }

    const rows = await this.getDb(hyperdrive)
      .select()
      .from(<%= entity.nameKebab %>Table)
      .where(conditions.length > 0 ? and(...conditions) : undefined)
      .orderBy(desc(<%= entity.nameKebab %>Table.createdAt))
      .limit(limit + 1);

    const hasMore = rows.length > limit;
    const items = hasMore ? rows.slice(0, limit) : rows;
    const lastItem = items[items.length - 1] as Record<string, unknown> | undefined;
    const nextCursor = hasMore && lastItem?.['createdAt'] instanceof Date
      ? (lastItem['createdAt'] as Date).toISOString()
      : null;

    return { items, nextCursor, hasMore };
  }

  /**
   * @author arefin
   * @description Insert a new <%= entity.namePascal %> entity into the database and return the created record
   */
  async create(data: New<%= entity.namePascal %>, hyperdrive?: Hyperdrive): Promise<<%= entity.namePascal %>Entity> {
    const rows = await this.getDb(hyperdrive)
      .insert(<%= entity.nameKebab %>Table)
      .values(data as never)
      .returning();
    const row = rows[0];
    if (!row) throw new AppError('DB_INSERT_FAILED', `Failed to insert <%= entity.namePascal %>`, 500);
    return row;
  }

  /**
   * @author arefin
   * @description Update an existing <%= entity.namePascal %> entity and return the modified record
   */
  async update(data: Update<%= entity.namePascal %>, hyperdrive?: Hyperdrive): Promise<<%= entity.namePascal %>Entity | null> {
    const { id, ...rest } = data;
    const updateData = { ...rest, updatedAt: new Date() };
    const rows = await this.getDb(hyperdrive)
      .update(<%= entity.nameKebab %>Table)
      .set(updateData as never)
      .where(eq(<%= entity.nameKebab %>Table.id, id))
      .returning();
    return rows[0] ?? null;
  }

  /**
   * @author arefin
   * @description <%= entity.hasSoftDelete ? 'Soft-delete a ' + entity.namePascal + ' entity by setting deletedAt timestamp' : 'Hard-delete a ' + entity.namePascal + ' entity by its unique identifier' %>
   */
  async delete(id: string, hyperdrive?: Hyperdrive): Promise<boolean> {
<% if (entity.hasSoftDelete) { %>
    const rows = await this.getDb(hyperdrive)
      .update(<%= entity.nameKebab %>Table)
      .set({ deletedAt: new Date() } as never)
      .where(and(eq(<%= entity.nameKebab %>Table.id, id), isNull(<%= entity.nameKebab %>Table.deletedAt)))
      .returning();
<% } else { %>
    const rows = await this.getDb(hyperdrive)
      .delete(<%= entity.nameKebab %>Table)
      .where(eq(<%= entity.nameKebab %>Table.id, id))
      .returning();
<% } %>
    return rows.length > 0;
  }
}
