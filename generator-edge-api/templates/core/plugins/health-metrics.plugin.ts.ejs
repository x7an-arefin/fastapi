import type { IPlugin, Application } from 'honestjs';
import type { Hono } from 'hono';

/**
 * @author arefin
 * @description Health & Metrics Plugin — exposes /health and /metrics endpoints for monitoring application status
 */
export class HealthAndMetricsPlugin implements IPlugin {
  meta = { name: 'HealthAndMetricsPlugin' };

  /**
   * @author arefin
   * @description Mount /health and /metrics routes after module registration
   */
  async afterModulesRegistered(_app: Application, hono: Hono): Promise<void> {
    hono.get('/health', async (c) => {
      const env = c.env as Record<string, unknown>;
      const checks: Record<string, { status: string; latencyMs?: number; error?: string }> = {};
      let overallStatus = 'healthy';

      // Database check
      const dbStart = Date.now();
      try {
        const { drizzle } = await import('drizzle-orm/postgres-js');
        const { sql } = await import('drizzle-orm');
        const hyperdrive = env['<%= db.binding %>'] as Hyperdrive | undefined;
        if (hyperdrive?.connectionString) {
          const db = drizzle(hyperdrive.connectionString);
          await db.execute(sql`SELECT 1`);
          checks['database'] = { status: 'up', latencyMs: Date.now() - dbStart };
        } else {
          checks['database'] = { status: 'unconfigured' };
          overallStatus = 'degraded';
        }
      } catch (err) {
        checks['database'] = { status: 'down', latencyMs: Date.now() - dbStart, error: String(err) };
        overallStatus = 'unhealthy';
      }

<% if (auth && auth.session.cache === 'workers-kv') { %>
      // KV check
      try {
        const kv = env['<%= auth.session.kvBinding %>'] as KVNamespace | undefined;
        if (kv) {
          await kv.get('__health_check__');
          checks['kv'] = { status: 'up' };
        } else {
          checks['kv'] = { status: 'unconfigured' };
        }
      } catch (err) {
        checks['kv'] = { status: 'down', error: String(err) };
        overallStatus = overallStatus === 'unhealthy' ? 'unhealthy' : 'degraded';
      }
<% } %>

      return c.json(
        {
          status: overallStatus,
          timestamp: new Date().toISOString(),
          app: '<%= app.name %>',
          version: '1.0.0',
          environment: (env['ENVIRONMENT'] as string) ?? 'development',
          checks,
        },
        overallStatus === 'unhealthy' ? 503 : 200,
      );
    });

    hono.get('/metrics', (c) => {
      return c.json({
        app: '<%= app.name %>',
        uptimeSeconds: Math.floor(performance.now() / 1000),
        memoryAllocated: 'edge-runtime',
      });
    });
  }
}
