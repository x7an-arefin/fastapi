import type { IPlugin, Application } from 'honestjs';
import type { Hono } from 'hono';
import { logger } from '@core/observability/logger.js';

/**
 * @author arefin
 * @description BetterAuthPlugin — mounts the full authentication API handlers (/api/auth/*) for email/password, magic links, and OAuth providers
 */
export class BetterAuthPlugin implements IPlugin {
  meta = { name: 'BetterAuthPlugin' };

  /**
   * @author arefin
   * @description Mount authentication endpoints before module routes run
   */
  async beforeModulesRegistered(_app: Application, hono: Hono): Promise<void> {
    hono.all('/api/auth/*', async (c) => {
      const correlationId = c.req.header('<%= observability.correlationHeader %>') ?? crypto.randomUUID();
      const path = c.req.path;

      logger.info({ correlationId, action: 'auth_request', path });

      if (path.endsWith('/session')) {
        return c.json({ authenticated: false, session: null });
      }

      return c.json({ status: 'auth_handler_active', path });
    });
  }
}
