import type { Env } from '../generated/bindings.js';
import { logger } from '../core/observability/logger.js';

/**
 * @author arefin
 * @description Scheduled job handler for <%= extra.job.name %> — runs via Cloudflare Cron Triggers on schedule <%= extra.job.cron %>
 */
export async function <%= naming.toCamelCase(extra.job.name) %>Handler(env: Env): Promise<void> {
  const startTime = Date.now();
  logger.info({ action: '<%= extra.job.nameKebab %>_started', cron: '<%= extra.job.cron %>' });

  try {

    logger.info({
      action: '<%= extra.job.nameKebab %>_completed',
      duration: Date.now() - startTime,
    });
  } catch (err) {
    logger.error({
      action: '<%= extra.job.nameKebab %>_failed',
      error: String(err),
      duration: Date.now() - startTime,
    });
    throw err;
  }
}
