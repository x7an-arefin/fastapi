<form [formGroup]="form" (ngSubmit)="onSubmit()" class="space-y-4">
<% formConfig.fields.forEach(function(field) { %>
  <div class="space-y-1.5">
    <label for="<%= field.name %>" class="text-xs font-semibold text-foreground tracking-wide uppercase">
      <%= field.label %><% if (field.required) { %><span class="text-destructive ml-1">*</span><% } %>
    </label>

<% if (field.control === 'textarea') { %>
    <textarea 
      hlmInput
      id="<%= field.name %>" 
      formControlName="<%= field.name %>" 
      rows="<%= field.rows || 3 %>"
      placeholder="<%= field.placeholder || '' %>"
      class="w-full"
    ></textarea>
<% } else if (field.control === 'select') { %>
    <select 
      hlmInput
      id="<%= field.name %>" 
      formControlName="<%= field.name %>"
      class="w-full"
    >
      <option value="" disabled>Select <%= field.label %></option>
<% (field.options || []).forEach(function(opt) { %>
      <option value="<%= opt.value %>"><%= opt.label %></option>
<% }); %>
    </select>
<% } else { %>
    <input 
      hlmInput
      id="<%= field.name %>" 
      type="<%= field.inputType || 'text' %>" 
      formControlName="<%= field.name %>" 
      placeholder="<%= field.placeholder || '' %>"
      class="w-full"
    />
<% } %>

    @if (hasError('<%= field.name %>')) {
      <p class="text-xs text-destructive mt-1 font-medium">
        <%= field.label %> is required or invalid.
      </p>
    }
  </div>
<% }); %>

  <div class="pt-4 border-t border-border flex justify-end gap-3">
    <button 
      type="button" 
      hlmBtn
      variant="outline"
      (click)="onCancel()" 
    >
      Cancel
    </button>
    <button 
      type="submit" 
      hlmBtn
      variant="default"
      [disabled]="isLoading()"
    >
      @if (isLoading()) {
        <span class="w-3.5 h-3.5 border-2 border-primary-foreground border-t-transparent rounded-full animate-spin mr-1"></span>
      }
      Save <%= labelSingular %>
    </button>
  </div>
</form>
