<% formConfig.fields.forEach(function(field) { %>
    '<%= field.name %>': [<%= field.required ? "''" : "''" %>, [<% if (field.required) { %>Validators.required<% if (field.validators && field.validators.length) { %>, <% } %><% } %><% if (field.validators) { field.validators.forEach(function(v, i) { if (v.type === 'minLength') { %>Validators.minLength(<%= v.value %>)<% } else if (v.type === 'maxLength') { %>Validators.maxLength(<%= v.value %>)<% } else if (v.type === 'email') { %>Validators.email<% } %><% if (i < field.validators.length - 1) { %>, <% } %>}); } %>]],
<% }); %>
  });
  
  ngOnChanges(): void {
    const val = this.initialValue();
    if (val) this.form.patchValue(val as never);
    else this.form.reset();
